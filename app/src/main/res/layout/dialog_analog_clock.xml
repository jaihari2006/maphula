<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip"
        android:backgroundTint="#475569"
        android:layout_marginBottom="16dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏰ ANALOG CHRONOMETER"
            android:textColor="@color/secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvAnalogClockModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8-BIT REALTIME"
            android:textColor="#00FFCC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:background="@drawable/bg_clock_8bit"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Continuous sweeping second-hand synchronized with the 8-bit digital clock."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Analog Clock Canvas View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <com.offlineai.app.ui.clock.AnalogClockView
            android:id="@+id/analogClockView"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Digital Readout Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvAnalogDigitalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17:05:42"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tvAnalogDigitalDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sunday, November 15, 2026"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAnalogTzInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Day 319 of 365 • UTC Synchronized Chrono"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Controls Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSweep"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🌊 Smooth Sweep"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseClock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Dismiss"
            android:textSize="11sp"
            android:backgroundTint="@color/surface_variant_dark"
            android:textColor="@color/text_primary" />
    </LinearLayout>

</LinearLayout>
