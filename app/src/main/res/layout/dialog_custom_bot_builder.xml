<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛠️ Build Custom Bot Archetype"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Create a bespoke AI challenger or defender to join Ravana's council and stress-test your proposals."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:layout_marginVertical="12dp" />

    <!-- Bot Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BOT CODENAME:"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etCustomBotName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="e.g. Cyber Inquisitor"
        android:textColorHint="#64748B"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Bot Title & Avatar Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPECIALTY TITLE:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etCustomBotTitle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="e.g. Memory Leak Auditor"
                android:textColorHint="#64748B"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVATAR:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etCustomBotAvatar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:hint="👾"
                android:text="👾"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:background="@drawable/bg_input_field" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stance Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BATTLE STANCE:"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/layoutStanceChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipStanceAttacker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="🔴 Attacker"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipStanceDefender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="🟢 Defender"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipStanceAuditor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="🟡 Auditor"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipStanceChaos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="🟣 Chaos"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipStanceSpecialist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="⚡ Specialist"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Tagline & Primary Focus -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRIMARY FOCUS / ANGLE OF ATTACK:"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etCustomBotFocus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:maxLines="4"
        android:hint="e.g. Evaluates deterministic garbage collection overhead and concurrency races under battery throttling."
        android:textColorHint="#64748B"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:background="@drawable/bg_input_field"
        android:padding="10dp"
        android:layout_marginBottom="16dp" />

    <!-- Deploy Button -->
    <Button
        android:id="@+id/btnDeployCustomBot"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="⚔️ Deploy Bot to Council"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_gradient" />

</LinearLayout>