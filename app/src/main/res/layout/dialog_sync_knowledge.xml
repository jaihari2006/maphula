<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/text_muted" />

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 Fetch Online Knowledge"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Maphula retrieves new information only when an internet connection is available, permanently caching it for offline retrieval."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- Connectivity Status Banner -->
    <LinearLayout
        android:id="@+id/layoutDialogStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip"
        android:padding="12dp">

        <View
            android:id="@+id/vDialogDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/accent_green" />

        <TextView
            android:id="@+id/tvDialogStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Checking connectivity..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Connectivity Policy Card with Slider & Auto-Switch Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:layout_marginTop="12dp"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONNECTIVITY CONTROLS"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Auto Switch Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleAutoSwitch"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🤖 Auto Switch: ON"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAutoSwitchExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Auto Switch follows hardware Wi-Fi/Cellular state. Turn OFF to use manual slider."
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <!-- Slider Bar for Switching Online & Offline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvSliderOfflineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Strict Offline"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekNetworkMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1"
                android:progress="0"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/tvSliderOnlineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Online"
                android:textColor="@color/secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSliderCurrentMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Current Mode: Strict Offline Air-Gap (Local)"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Search Online Topic Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Download Specific Topic to Offline Database:"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/etOnlineTopic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. CRISPR, James Webb, Fusion..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:inputType="text"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadTopic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Fetch"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Divider or Or -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="14dp"
        android:gravity="center"
        android:text="— OR —"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- 1-Click Sync Trending Packs -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSyncCurated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ Sync Latest Trending Knowledge Packs"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:cornerRadius="8dp" />

    <!-- Loading Indicator & Feedback Message -->
    <ProgressBar
        android:id="@+id/pbSync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSyncFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
